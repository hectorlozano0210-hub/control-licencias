# ==============================================================================
# CONFIGURACIÓN DE ENTORNO: ECOSISTEMA VERCEL + RENDER + SUPABASE
# ==============================================================================
# Copia este archivo como .env.production en tus plataformas de despliegue:
# - Variables de Backend (Render / Cloud Run)
# - Variables de Frontend (Vercel)
# NUNCA incluyas claves privadas reales en el control de versiones.
# ==============================================================================

# ==============================================================================
# 1. VARIABLES DEL SERVICIO BACKEND (RENDER / DOCKER / STANDALONE)
# ==============================================================================
NODE_ENV=production
PORT=8080
HOSTNAME=0.0.0.0

# Conexión directa a PostgreSQL Supabase (Pooler / Direct Connection)
DATABASE_URL=postgresql://postgres.usuario:password_secreta@aws-0-region.pooler.supabase.com:6543/postgres

# Supabase API URL y Service Role Key (Permite operaciones administrativas sin RLS)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.ejemplo_service_role_key_para_backend_en_render

# Dominio del Frontend autorizado en Vercel para CORS (sin comodín '*')
FRONTEND_URL=https://coreauth-license-hub.vercel.app

# Orígenes adicionales autorizados separados por comas
CORS_ALLOWED_ORIGINS=https://coreauth-license-hub.vercel.app,https://licensing.tuempresa.com

# Secreto criptográfico maestro para firma de Tokens Offline (mínimo 32 caracteres)
LICENSE_SIGNING_SECRET=tu-clave-secreta-criptografica-maestra-min-32-chars

# Políticas de Rate Limiting (Límites por IP)
RATE_LIMIT_AUTH_MAX=15
RATE_LIMIT_STANDARD_MAX=120
RATE_LIMIT_TRANSACTIONAL_MAX=25

# ==============================================================================
# 2. VARIABLES DEL CLIENTE FRONTEND (VERCEL / CLIENT-SIDE)
# ==============================================================================
# URL base de la API backend desplegada en Render
NEXT_PUBLIC_API_URL=https://coreauth-api.onrender.com

# Credenciales públicas de Supabase para clientes web y realtime
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.ejemplo_anon_key_publica
